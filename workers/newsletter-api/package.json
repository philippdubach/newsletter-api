{
  "name": "newsletter-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers API for newsletter subscriptions with rate limiting, email validation, and R2 storage integration",
  "author": "Philipp Dubach",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philippdubach/newsletter-api.git"
  },
  "keywords": [
    "cloudflare-workers",
    "newsletter",
    "email",
    "subscription",
    "api",
    "serverless",
    "kv",
    "r2",
    "resend"
  ],
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-deploy-config.mjs --refuse-dev-deploy",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:config": "node --test scripts/check-deploy-config.test.mjs scripts/deploy-production.test.mjs",
    "check:config": "node scripts/check-deploy-config.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:config && npm run test && npm run check:config"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "smol-toml": "^1.9.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
